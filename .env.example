# Variaveis de ambiente do Vite (injetadas em BUILD-TIME, nao em runtime).
# No EasyPanel, defina estas variaveis como build args / environment do build.
# Troca de env exige REBUILD da imagem.

# URL do projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anon (publica) do Supabase
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Autenticacao previa da plataforma (login/senha fixos, provisorio ate existir
# autenticacao por usuario). Sessao expira 1h apos o login; sem as duas
# variaveis, o acesso fica liberado sem tela de login.
#
# EM PRODUCAO prefira definir estas duas como env de RUNTIME do container (no
# EasyPanel: aba Environment do servico) - o entrypoint gera /config.js no boot
# e o app le de la, com precedencia sobre o build-time. Assim trocar a senha
# exige so um restart, sem rebuild. Ver README-deploy.md.
#
# ATENCAO: nos dois caminhos a credencial fica no lado do cliente (bundle ou
# /config.js) e e legivel por quem inspecionar o site - barra acesso casual,
# NAO e protecao contra alguem tecnicamente capaz.
VITE_AUTH_USER=
VITE_AUTH_PASSWORD=

# Growth e Performance — ajuste manual de faturamento, identificado por RA
# (NAO o nome do aluno — variavel VITE_ e embutida no bundle JS publico em
# build-time, entao um nome aqui vazaria para qualquer visitante do site;
# RA nao identifica a pessoa a quem le o codigo/bundle).
# Nunca renderizado nem logado; cruzamento apenas em memoria.
VITE_GROWTH_AJUSTE_ALUNO_RA=
VITE_GROWTH_AJUSTE_DATA=2026-05-28
